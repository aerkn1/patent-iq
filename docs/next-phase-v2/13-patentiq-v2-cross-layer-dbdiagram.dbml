}

Table silver_family_status_pt {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  snapshot_date date [pk]
  family_composite_status varchar
  active_jurisdiction_count int
  active_grant_branch_count int
  lapsed_jurisdiction_count int
  opposed_branch_count int
  has_any_active_grant boolean
  is_dead_family boolean
}

Table silver_ep_register_core {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
