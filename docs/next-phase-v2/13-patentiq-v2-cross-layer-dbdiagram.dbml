}

Table bronze_ext_iso_country_map {
  iso2 varchar [pk]
  iso3 varchar
  country_name varchar
}

Table bronze_ext_world_bank_gdp_ppp {
  iso3 varchar [pk]
  snapshot_year int [pk]
  gdp_value double
}

Table bronze_ext_us_chamber_ip_index {
  iso2 varchar [pk]
  snapshot_year int [pk]
  ip_score double
}

Table bronze_ext_up_member_states {
  jurisdiction_code varchar [pk]
}

Table bronze_ext_kind_code_normalization_seed {
  jurisdiction_code varchar [pk]
  kind_code varchar [pk]
  universal_stage varchar
  stage_multiplier double
  is_enforceable boolean
  legal_status_proxy varchar
}

Table bronze_ext_oecd_indicator_seed {
  appln_id bigint [pk]
