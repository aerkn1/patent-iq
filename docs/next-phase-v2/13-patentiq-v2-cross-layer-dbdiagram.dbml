Project PatentIQ_V2 {
  database_type: "PostgreSQL"
  Note: "Logical cross-layer PatentIQ V2 warehouse model for dbdiagram.io. Bronze = raw/source-preserving, Silver = normalized reusable analytics, Gold = product marts."
}

Table bronze_patstat_appln {
  appln_id bigint [pk]
  appln_auth varchar
  appln_kind varchar
  appln_filing_date date
  appln_filing_year int
  earliest_filing_date date
  earliest_filing_year int
  earliest_publn_date date
  granted varchar
  docdb_family_id bigint
  inpadoc_family_id bigint
  docdb_family_size int
  nb_citing_docdb_fam int
  nb_applicants int
  nb_inventors int
}

Table bronze_patstat_appln_title {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  appln_title_lg varchar [pk]
  appln_title text
}

Table bronze_patstat_appln_abstr {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  appln_abstract_lg varchar [pk]
  appln_abstract text
}

Table bronze_patstat_appln_prior {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  prior_appln_id bigint [pk]
  prior_appln_seq_nr int
}

Table bronze_patstat_person {
  person_id bigint [pk]
  person_name varchar
  person_ctry_code varchar
  doc_std_name varchar
  psn_id bigint
  psn_name varchar
  han_id bigint
  han_name varchar
  psn_sector varchar
}

Table bronze_patstat_pers_appln {
  person_id bigint [pk, ref: > bronze_patstat_person.person_id]
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  applt_seq_nr int
  invt_seq_nr int
}

Table bronze_patstat_appln_ipc {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  ipc_class_symbol varchar [pk]
  ipc_class_level varchar
  ipc_version date
}

Table bronze_patstat_appln_cpc {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  cpc_class_symbol varchar [pk]
}

Table bronze_patstat_pat_publn {
  pat_publn_id bigint [pk]
  appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  publn_auth varchar
  publn_nr varchar
  publn_kind varchar
  publn_date date
}

Table bronze_patstat_citation {
  pat_publn_id bigint [pk, ref: > bronze_patstat_pat_publn.pat_publn_id]
  citn_id bigint [pk]
  cited_pat_publn_id bigint [ref: > bronze_patstat_pat_publn.pat_publn_id]
  cited_appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  cited_npl_publn_id varchar
  citn_origin varchar
}

Table bronze_patstat_npl_publn {
  npl_publn_id varchar [pk]
  npl_biblio text
}

Table bronze_patstat_docdb_fam_citn {
  docdb_family_id bigint [pk]
  cited_docdb_family_id bigint [pk]
}

Table bronze_patstat_appln_techn_field {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  techn_field_nr int [pk]
  weight float
}

Table bronze_patstat_inpadoc_legal_event {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  event_auth varchar [pk]
  event_code varchar [pk]
  event_date date [pk]
}

Table bronze_uspto_ft_document {
  publication_number_full varchar [pk]
  application_number_full varchar
  publication_kind varchar
  publication_date date
  source_file_name varchar
}

Table bronze_uspto_ft_biblio_application {
  publication_number_full varchar [pk, ref: > bronze_uspto_ft_document.publication_number_full]
  application_number_full varchar
  application_type varchar
  us_application_series_code varchar
  filing_date date
}

Table bronze_uspto_ft_abstract {
  publication_number_full varchar [pk, ref: > bronze_uspto_ft_document.publication_number_full]
  abstract_text text
}

Table bronze_uspto_ft_claims {
  publication_number_full varchar [pk, ref: > bronze_uspto_ft_document.publication_number_full]
  claim_id varchar [pk]
  claim_num int
  claim_text_plain text
}

Table bronze_epab_document {
  epab_doc_id varchar [pk]
  publication_number_full varchar
  application_number_full varchar
  publication_kind varchar
  publication_date date
}

Table bronze_epab_publication {
  epab_doc_id varchar [pk, ref: > bronze_epab_document.epab_doc_id]
  publication_authority varchar
  publication_number varchar
  publication_kind varchar
  publication_date date
}

Table bronze_epab_application {
  epab_doc_id varchar [pk, ref: > bronze_epab_document.epab_doc_id]
  application_authority varchar
  application_number varchar
  filing_date date
}

Table bronze_epab_abstract {
  epab_doc_id varchar [pk, ref: > bronze_epab_document.epab_doc_id]
  abstract_text text
  language_code varchar [pk]
}

Table bronze_epab_claims {
  epab_doc_id varchar [pk, ref: > bronze_epab_document.epab_doc_id]
  claim_id varchar [pk]
  claim_sequence_no int
  language_code varchar
  claim_text_plain text
}

Table bronze_reg101_appln {
  id bigint [pk]
  appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  appln_auth varchar
  appln_nr varchar
  appln_filing_date date
  filing_lg varchar
  status_code varchar
}

Table bronze_reg107_parties {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  set_seq_nr int [pk]
  seq_nr int [pk]
  party_type varchar [pk]
  is_latest boolean
  name varchar
  country varchar
  customer_id bigint
}

Table bronze_reg111_licensee {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  licensee_seq_nr int [pk]
  type_license varchar
  name varchar
  country varchar
