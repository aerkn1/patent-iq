  citing_docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  cited_docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  citing_appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  cited_appln_id bigint [ref: > bronze_patstat_appln.appln_id]
