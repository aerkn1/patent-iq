}

Table bronze_reg125_appeal {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  appeal_nr int [pk]
  appeal_date date [pk]
  phase varchar [pk]
  result varchar
  result_date date
}

Table bronze_reg130_opponent {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  oppt_nr int [pk]
  is_latest boolean
  oppt_name varchar
  oppt_country varchar
  date_opp_filed date
  oppt_status varchar
  oppt_status_date date
