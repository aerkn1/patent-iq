}

Table silver_family_core {
  docdb_family_id bigint [pk]
  inpadoc_family_id bigint
  family_earliest_priority_date date
  family_priority_year int
  is_main_window_family boolean
  is_heritage_backfill_family boolean
  is_out_of_bounds_ghost boolean
  earliest_priority_appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  family_size_docdb int
  counting_unit varchar
}

Table silver_family_member_publications {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  pat_publn_id bigint [pk, ref: > bronze_patstat_pat_publn.pat_publn_id]
  jurisdiction_code varchar
  publn_kind varchar
  publn_date date
  is_application_stage boolean
  is_grant_stage boolean
  is_modifier_stage boolean
}

Table silver_family_text_representative {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  representative_appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  representative_publn_id bigint [ref: > bronze_patstat_pat_publn.pat_publn_id]
  representative_language varchar
  representative_stage varchar
  representative_title_en text
  representative_abstract_en text
  representative_claim_1_en text
  text_provenance varchar
  is_abstract_fallback boolean
}

Table silver_assignee_harmonized {
  appln_id bigint [pk, ref: > bronze_patstat_appln.appln_id]
  person_id bigint [pk, ref: > bronze_patstat_person.person_id]
  owner_name_raw varchar
  owner_name_norm varchar
  psn_id bigint
  psn_name varchar
  han_id bigint
  han_name varchar
  harmonized_owner_id bigint
  ultimate_parent_name varchar
}

Table silver_kind_code_normalization {
  jurisdiction_code varchar [pk]
  kind_code varchar [pk]
  universal_stage varchar
  stage_multiplier double
  is_enforceable boolean
  is_application_stage boolean
  is_post_grant_modifier boolean
  legal_status_proxy varchar
  method_version varchar
}

Table silver_tiered_market_weighting {
  jurisdiction_code varchar [pk]
  snapshot_year int [pk]
  gdp_value double
  ip_score double
  gdp_tier_weight double
  final_market_multiplier double
}

Table silver_up_status {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  has_up_registration boolean
  up_detection_method varchar
  up_member_state_count int
}

Table silver_family_jurisdiction_unrolled {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  jurisdiction_code varchar [pk]
