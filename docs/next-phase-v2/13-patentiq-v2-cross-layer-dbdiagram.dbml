}

Table gold_family_forecast_summary {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  snapshot_date date [pk]
  grant_probability_pct double
  aggregate_lapse_risk_pct double
  friction_risk_pct double
}

Table gold_portfolio_forecast_summary {
  harmonized_owner_id bigint [pk]
  snapshot_date date [pk]
  likely_grants_count double
  expected_lapses_count double
  high_friction_family_count double
}

Table gold_publication_ep_register_evidence {
  appln_id bigint [pk, ref: > silver_ep_register_core.appln_id]
  snapshot_date date [pk]
  ep_display_status_text varchar
  ep_opponent_names text
  ep_opponent_agent_names text
  ep_register_lead_agent_name varchar
  ep_register_up_status_text varchar
}

Table gold_semantic_match_context {
  query_id varchar [pk]
  matched_docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  semantic_similarity_score double
  chronology_scope varchar
  ui_blocking_power_score double
  family_composite_status varchar
}

Table vec_family_embeddings {
  docdb_family_id bigint [pk, ref: > silver_family_core.docdb_family_id]
  vector_space varchar [pk]
  representative_appln_id bigint
  representative_publn_id bigint
  text_provenance varchar
  is_abstract_fallback boolean
  earliest_priority_timestamp bigint
  wipo_field varchar
  overall_bp_percentile int
  embedding_model varchar
}

Table ml_model_registry {
  model_name varchar [pk]
  model_version varchar [pk]
  target_metric varchar
  training_snapshot_date date
}
