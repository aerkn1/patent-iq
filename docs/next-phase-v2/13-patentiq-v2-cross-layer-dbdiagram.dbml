}

Table bronze_reg201_proc_step {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  step_id bigint [pk]
  step_phase varchar
  step_code varchar
  step_result varchar
  time_limit int
}

Table bronze_reg202_proc_step_text {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  step_id bigint [pk]
  step_text text
}

Table bronze_reg203_proc_step_date {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  step_id bigint [pk]
  step_date date [pk]
}

Table bronze_reg301_event_data {
  id bigint [pk, ref: > bronze_reg101_appln.id]
  event_date date [pk]
  event_code varchar [pk]
}

Table bronze_reg402_event_text {
  event_code varchar [pk]
  event_text text
}

Table bronze_reg701_appln {
  id bigint [pk]
  appln_id bigint [ref: > bronze_patstat_appln.appln_id]
  status_code varchar
}

Table bronze_reg731_event_data {
  id bigint [pk, ref: > bronze_reg701_appln.id]
  event_date date [pk]
  event_code varchar [pk]
}

Table bronze_reg741_appln_status {
  status_code varchar [pk]
  status_text varchar
}

Table bronze_reg742_event_text {
  event_code varchar [pk]
  event_text text
}

Table bronze_ref_country {
  ctry_code varchar [pk]
  st3_name varchar
}

Table bronze_ref_legal_event_code {
  event_auth varchar [pk]
  event_code varchar [pk]
  event_text varchar
}

Table bronze_ref_techn_field_ipc {
  ipc_maingroup_symbol varchar [pk]
  techn_field_nr int [pk]
  techn_sector varchar
